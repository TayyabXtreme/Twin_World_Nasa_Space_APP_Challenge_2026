# Copy to .env.local and fill in. Never commit real keys.

# Rovi's live brain: Claude on Amazon Bedrock (app/api/rovi, lib/rovi/server/brain.ts).
# Plain anthropic.* ids use Bedrock's Mantle (Messages API) endpoint; us./global. inference-profile ids use bedrock-runtime.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# "demo" answers from Rovi's built-in script and never calls Bedrock. Leave unset for live answers.
# AI_MODE=demo

# Mantle ids only (anthropic.*): model that retries a declined request; "none" turns the refusal fallback off.
# ROVI_FALLBACK_MODEL=anthropic.claude-opus-4-8
